<odoo>
    <record model="ir.ui.view" id="auth_api_key_form_view">
        <field name="name">auth.api.key.form (in auth_api_key)</field>
        <field name="model">auth.api.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" class="oe_inline" />
                    </h1>
                    <field name="key_hash" invisible="1" />
                    <div class="alert alert-info" role="alert" invisible="not key_hash">
                        The key is stored hashed and cannot be displayed.
                        Enter a new key to replace it.
                    </div>
                    <group name="config" colspan="4" col="4">
                        <field name="user_id" colspan="4" />
                        <field name="key" colspan="4" password="True" />
                        <field name="expiration_date" />
                        <field name="last_used_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="auth_api_key_tree_view">
        <field name="name">auth.api.key.list (in auth_api_key)</field>
        <field name="model">auth.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_id" />
                <field name="expiration_date" optional="show" />
                <field name="last_used_date" optional="show" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="auth_api_key_search_view">
        <field name="name">auth.api.key.search (in auth_api_key)</field>
        <field name="model">auth.api.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="user_id" />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('expiration_date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"
                />
                <filter
                    name="never_used"
                    string="Never used"
                    domain="[('last_used_date', '=', False)]"
                />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="auth_api_key_act_window">
        <field name="name">Auth Api Key</field>
        <field name="res_model">auth.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record model="ir.ui.menu" id="auth_api_key_menu">
        <field name="name">Auth Api Key</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="action" ref="auth_api_key_act_window" />
        <field name="sequence" eval="100" />
    </record>
</odoo>
