<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (in auth_api_key_expire)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="inside">
                <setting
                    groups="base.group_no_one"
                    id="api_key_expiration_warning"
                    string="API key expiration warning"
                    help="Who gets a To Do, and how long before, when an API key is about to expire"
                >
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="auth_api_key_expire_group_id"
                                class="col-lg-4"
                            />
                            <field name="auth_api_key_expire_group_id" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="auth_api_key_expire_warning_days"
                                class="col-lg-4"
                            />
                            <field name="auth_api_key_expire_warning_days" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
